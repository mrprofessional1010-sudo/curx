# ==============================================================================
# CURX — Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local
# DO NOT commit .env.local or any real secrets to source control.
# ==============================================================================

# --- Supabase Configuration (Client & Server) ---
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase Anonymous / Public API Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Optional) Supabase Service Role Key for administrative backend scripts (NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=

# --- NVIDIA NIM / DeepSeek AI Assistant (Server-Side Only) ---
# NVIDIA NIM API Key for DeepSeek conversational explanation layer
NVIDIA_API_KEY=

# NVIDIA NIM OpenAI-Compatible Base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA Model Identifier
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# --- Google Gemini AI (Optional Alternative LLM Layer) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- ClinPGx Public API Sync (Server-Side Ingestion) ---
# Public REST base endpoint (public endpoints do not require API key)
CLINPGX_API_BASE_URL=https://api.clinpgx.org/v1
# CLINPGX_API_KEY=
